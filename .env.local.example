# Browser-exposed JavaScript key from https://developers.kakao.com/
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Server-only keys. Never add NEXT_PUBLIC_ to these variables.
TOUR_API_KEY=
# Optional: Google Cloud billing + Places API (New) enabled. Server-only.
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=

# Optional but strongly recommended for production: distributed API rate limits.
# When both are set, /api/chat and /api/tour share limits across Vercel instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
